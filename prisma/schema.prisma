generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Projects shown on the homepage and /projects/[slug].
/// Localized fields are stored flat with an "Ar" suffix instead of a
/// nested object — simpler to store/query, and mapped back into the
/// existing `{ ...fields, ar: {...} }` shape the frontend already expects.
model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  order            Int      @default(0)
  type             String
  published        Boolean  @default(true)
  title            String
  tagline          String
  overview         String
  problem          String
  solution         String
  features         Json
  architecture     String
  challenges       String
  lessonsLearned   String
  titleAr          String
  taglineAr        String
  overviewAr       String
  problemAr        String
  solutionAr       String
  featuresAr       Json
  architectureAr   String
  challengesAr     String
  lessonsLearnedAr String
  techStack        Json
  githubUrl        String
  backendGithubUrl String?
  liveUrl          String?
  relatedSlugs     Json
  metrics          Json
  images           Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  videoUrl         String?
  results          String?
  resultsAr        String?
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  visitorId String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  titleAr     String
  excerpt     String
  excerptAr   String
  content     String
  contentAr   String
  readingTime String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Client testimonials shown in the homepage Testimonials section.
/// Email signups collected from the blog page.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  quote     String
  rating    Int      @default(5)
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-row table controlling the availability badge shown in the navbar.
model AvailabilityStatus {
  id            String    @id @default("singleton")
  status        String    @default("available")
  availableFrom DateTime?
  updatedAt     DateTime  @updatedAt
}

/// Single-row table holding the editable content of the /about page.
model AboutContent {
  id          String   @id @default("singleton")
  intro       String
  introAr     String
  approach    String
  approachAr  String
  journey     Json
  journeyAr   Json
  updatedAt   DateTime @updatedAt
  resumeUrl   String?
  calendlyUrl String?
}
